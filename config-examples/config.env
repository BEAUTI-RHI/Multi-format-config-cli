# ==========================================
# Example Global Configuration File (.env)
# ==========================================

# Global Variables
APP_NAME="MyAwesomeApp"
VERSION="2.4.1"
RELEASE_DATE="2026-09-22"
IS_PRODUCTION=false

# Database Configuration (Flattened from TOML table)
DB_SERVER="192.168.1.50"
DB_PORTS="8001,8002,8003"
DB_CONNECTION_MAX=5000
DB_ENABLED=true

# Database Credentials (Flattened from nested TOML table)
DB_USER="admin"
DB_PASSWORD="super_secure_password_123"

# Database Timeouts
DB_TIMEOUT_CONNECTION=30
DB_TIMEOUT_READ=60

# Data Types & Formats
BASIC_STRING="Hello World"
MULTILINE_STRING="This is a string\nthat spans\nmultiple lines."
INTEGER=42
FLOAT=3.14159
TIMESTAMP_UTC="1979-05-27T07:32:00Z"

# Coordinates (Flattened inline table)
COORDINATES_X=40.7128
COORDINATES_Y=-74.0060

